@using STEMMWebApp.Models

@model List<NotificationItem>
@{
    ViewData["Title"] = "Notifications";
    string IconFor(string t) => t switch { "alert" => "exclamation-triangle", "report" => "file-earmark-bar-graph", _ => "gear" };
    string ColorFor(string t) => t switch { "alert" => "var(--red)", "report" => "var(--cyan)", _ => "var(--amber)" };
}

<div class="card">
    <div class="section-head">
        <span class="section-title">Notifications</span>
        <button class="section-action">Mark all as read</button>
    </div>
    @foreach (var n in Model)
    {
        <div class="list-row" style="padding-left:0; padding-right:0; background:@(n.Read ? "transparent" : "#f59e0b0a");">
            <span style="color:@(ColorFor(n.Type)); margin-top:2px;"><i class="bi bi-@(IconFor(n.Type))"></i></span>
            <div style="flex:1; min-width:0;">
                <div style="font-weight:@(n.Read ? "400" : "600"); font-size:14px;">@n.Title</div>
                <div style="font-size:13px; color:var(--muted-foreground); margin-top:2px;">@n.Body</div>
            </div>
            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px; flex-shrink:0;">
                <span class="mono" style="font-size:11px; color:var(--muted-foreground);">@n.Time</span>
                @if (!n.Read)
                {
                    <span class="dot" style="background:var(--primary);"></span>
                }
            </div>
        </div>
    }
</div>