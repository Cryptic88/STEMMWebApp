@using STEMMWebApp.Models

@model List<NotificationItem>

@{
    ViewData["Title"] = "Notifications";

    string IconFor(string t) => t switch
    {
        "alert" => "exclamation-triangle",
        "report" => "file-earmark-bar-graph",
        _ => "gear"
    };

    string ColorFor(string t) => t switch
    {
        "alert" => "var(--red)",
        "report" => "var(--cyan)",
        _ => "var(--amber)"
    };
}


<div class="card">

    <div class="section-head">

        <span class="section-title">
            Notifications
        </span>

        <button class="section-action">
            Mark all as read
        </button>

    </div>


    <div style="
        display:flex;
        flex-direction:column;
        gap:4px;
    ">

        @foreach (var n in Model)
        {
            /*
             * Notifications linked to an alert become clickable.
             * System and report notifications remain normal items.
             */

            if (!string.IsNullOrEmpty(n.AlertId))
            {
                <a asp-controller="Alerts"
                   asp-action="Detail"
                   asp-route-id="@n.AlertId"
                   class="list-row"
                   style="
                        margin-left:10px;
                        margin-right:10px;
                        padding-left:14px;
                        padding-right:14px;
                        border-radius:8px;
                        text-decoration:none;
                        color:inherit;
                        cursor:pointer;
                        background:@(
                            n.Read
                                ? "transparent"
                                : "rgba(245, 158, 11, 0.045)"
                        );
                   ">


                    <!-- Notification icon -->

                    <span style="
                        color:@ColorFor(n.Type);
                        margin-top:2px;
                        flex-shrink:0;
                    ">

                        <i class="bi bi-@IconFor(n.Type)"></i>

                    </span>


                    <!-- Notification content -->

                    <div style="
                        flex:1;
                        min-width:0;
                        padding-right:10px;
                    ">

                        <div style="
                            font-weight:@(n.Read ? "400" : "600");
                            font-size:14px;
                            line-height:1.4;
                        ">

                            @n.Title

                        </div>


                        <div style="
                            font-size:13px;
                            color:var(--muted-foreground);
                            margin-top:3px;
                            line-height:1.45;
                        ">

                            @n.Body

                        </div>

                    </div>


                    <!-- Time + unread indicator -->

                    <div style="
                        display:flex;
                        flex-direction:column;
                        align-items:flex-end;
                        justify-content:center;
                        gap:6px;
                        flex-shrink:0;
                        min-width:55px;
                    ">

                        <span class="mono"
                              style="
                                font-size:11px;
                                color:var(--muted-foreground);
                                white-space:nowrap;
                              ">

                            @n.Time

                        </span>


                        @if (!n.Read)
                        {
                            <span class="dot"
                                  style="
                                    background:var(--primary);
                                    width:7px;
                                    height:7px;
                                    border-radius:50%;
                                    display:block;
                                  ">
                            </span>
                        }

                    </div>


                    <!-- Click indicator -->

                    <i class="bi bi-chevron-right"
                       style="
                            margin-left:8px;
                            color:var(--muted-foreground);
                            font-size:12px;
                       ">
                    </i>

                </a>
            }
            else
            {
                <!-- Non-alert notification -->

                <div class="list-row"
                     style="
                        margin-left:10px;
                        margin-right:10px;
                        padding-left:14px;
                        padding-right:14px;
                        border-radius:8px;
                        background:@(
                            n.Read
                                ? "transparent"
                                : "rgba(245, 158, 11, 0.045)"
                        );
                     ">


                    <!-- Notification icon -->

                    <span style="
                        color:@ColorFor(n.Type);
                        margin-top:2px;
                        flex-shrink:0;
                    ">

                        <i class="bi bi-@IconFor(n.Type)"></i>

                    </span>


                    <!-- Notification content -->

                    <div style="
                        flex:1;
                        min-width:0;
                        padding-right:10px;
                    ">

                        <div style="
                            font-weight:@(n.Read ? "400" : "600");
                            font-size:14px;
                            line-height:1.4;
                        ">

                            @n.Title

                        </div>


                        <div style="
                            font-size:13px;
                            color:var(--muted-foreground);
                            margin-top:3px;
                            line-height:1.45;
                        ">

                            @n.Body

                        </div>

                    </div>


                    <!-- Time + unread indicator -->

                    <div style="
                        display:flex;
                        flex-direction:column;
                        align-items:flex-end;
                        justify-content:center;
                        gap:6px;
                        flex-shrink:0;
                        min-width:55px;
                    ">

                        <span class="mono"
                              style="
                                font-size:11px;
                                color:var(--muted-foreground);
                                white-space:nowrap;
                              ">

                            @n.Time

                        </span>


                        @if (!n.Read)
                        {
                            <span class="dot"
                                  style="
                                    background:var(--primary);
                                    width:7px;
                                    height:7px;
                                    border-radius:50%;
                                    display:block;
                                  ">
                            </span>
                        }

                    </div>

                </div>
            }
        }

    </div>

</div>