@using STEMMWebApp.Models

@model List<Meter>

@{
    ViewData["Title"] = "Devices";

    string StatusBadgeClass(string s) => s switch
    {
        "Warning" => "badge-warning",
        "Online" => "badge-online",
        "Offline" => "badge-offline",
        _ => "badge-info",
    };

    string SignalBars(int bars)
    {
        var html = "<span style=\"display:flex; align-items:flex-end; gap:1px; height:12px;\">";

        for (int b = 1; b <= 4; b++)
        {
            var h = b * 25;
            var color = b <= bars ? "var(--cyan)" : "var(--muted)";

            html += $"<span style=\"width:3px; border-radius:1px; height:{h}%; background:{color}; display:inline-block;\"></span>";
        }

        return html + "</span>";
    }
}


<!-- =========================================================
     SUMMARY CARDS
     ========================================================= -->

<div class="grid grid-3" style="margin-bottom:24px;">

    <div class="card stat-card">

        <span class="stat-label">
            Total Meters
        </span>

        <span class="stat-value">
            @Model.Count
        </span>

        <span class="stat-sub">
            Registered devices
        </span>

    </div>


    <div class="card stat-card">

        <span class="stat-label">
            Online
        </span>

        <span class="stat-value">
            @Model.Count(m => m.Status == "Online")
        </span>

        <span class="stat-sub">
            Reporting normally
        </span>

    </div>


    <div class="card stat-card">

        <span class="stat-label">
            Attention
        </span>

        <span class="stat-value">
            @Model.Count(m => m.Status != "Online")
        </span>

        <span class="stat-sub">
            Warning or offline
        </span>

    </div>

</div>


<!-- =========================================================
     DEVICES
     ========================================================= -->

<div class="card">

    <!-- =====================================================
         FILTER BAR
         ===================================================== -->

    <div style="
        display:flex;
        align-items:center;
        gap:12px;
        margin-bottom:20px;
        flex-wrap:wrap;
    ">


        <!-- Search -->

        <div class="search-box"
             style="max-width:280px;">

            <i class="bi bi-search"
               style="font-size:13px;">
            </i>

            <input type="text"
                   id="deviceSearch"
                   placeholder="Search meters..."
                   autocomplete="off" />

        </div>


        <!-- Status Filters -->

        <div style="
            display:flex;
            gap:6px;
            flex-wrap:wrap;
        ">

            <button type="button"
                    class="btn device-filter active"
                    data-filter="All">

                All

            </button>


            <button type="button"
                    class="btn device-filter"
                    data-filter="Online">

                Online

            </button>


            <button type="button"
                    class="btn device-filter"
                    data-filter="Warning">

                Warning

            </button>


            <button type="button"
                    class="btn device-filter"
                    data-filter="Offline">

                Offline

            </button>

        </div>


        <div style="flex:1"></div>


        <!-- Add Meter -->

        <a asp-controller="Devices"
           asp-action="Onboard"
           class="btn btn-primary"
           style="
                display:inline-flex;
                align-items:center;
                gap:8px;
           ">

            <i class="bi bi-plus-lg"></i>

            Add Meter

        </a>

    </div>


    <!-- =====================================================
         DEVICE COUNT
         ===================================================== -->

    <div id="deviceResultCount"
         style="
            font-size:12px;
            color:var(--muted-foreground);
            margin-bottom:12px;
         ">

        Showing @Model.Count meter@(Model.Count == 1 ? "" : "s")

    </div>


    <!-- =====================================================
         DEVICE TABLE
         ===================================================== -->

    <table class="data-table">

        <thead>

            <tr>

                <th>
                    Meter ID
                </th>

                <th>
                    Name
                </th>

                <th>
                    Department
                </th>

                <th>
                    Last Reading
                </th>

                <th>
                    Signal
                </th>

                <th>
                    Status
                </th>

                <th></th>

            </tr>

        </thead>


        <tbody id="deviceTableBody">

            @foreach (var m in Model)
            {

                <tr class="device-row"
                    data-status="@m.Status"
                    data-search="@($"{m.Id} {m.Name} {m.Dept}")"
                    onclick="location.href='@Url.Action("Detail", "Devices", new { id = m.Id })'"
                    style="cursor:pointer;">


                    <!-- Meter ID -->

                    <td class="mono"
                        style="
                            font-size:12px;
                            color:var(--muted-foreground);
                        ">

                        @m.Id

                    </td>


                    <!-- Name -->

                    <td style="font-weight:500;">

                        @m.Name

                    </td>


                    <!-- Department -->

                    <td style="color:var(--muted-foreground);">

                        @m.Dept

                    </td>


                    <!-- Last Reading -->

                    <td class="mono"
                        style="color:var(--primary);">

                        @m.LastReading

                    </td>


                    <!-- Signal -->

                    <td>

                        @Html.Raw(SignalBars(m.Signal))

                    </td>


                    <!-- Status -->

                    <td>

                        <span class="badge @StatusBadgeClass(m.Status)">
                            @m.Status
                        </span>

                    </td>


                    <!-- Arrow -->

                    <td>

                        <i class="bi bi-chevron-right"
                           style="color:var(--muted-foreground);">
                        </i>

                    </td>

                </tr>

            }

        </tbody>

    </table>


    <!-- =====================================================
         EMPTY STATE
         ===================================================== -->

    <div id="deviceEmptyState"
         style="
            display:none;
            text-align:center;
            padding:40px 20px;
            color:var(--muted-foreground);
         ">

        <i class="bi bi-search"
           style="
                font-size:28px;
                display:block;
                margin-bottom:10px;
           ">
        </i>

        <div style="
            font-size:14px;
            font-weight:500;
            color:var(--foreground);
            margin-bottom:4px;
        ">

            No meters found

        </div>

        <div style="font-size:12px;">

            Try changing your search or filter.

        </div>

    </div>

</div>


<!-- =========================================================
     DEVICE FILTER SCRIPT
     ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("deviceSearch");

        const filterButtons =
            document.querySelectorAll(".device-filter");

        const rows =
            document.querySelectorAll(".device-row");

        const emptyState =
            document.getElementById("deviceEmptyState");

        const resultCount =
            document.getElementById("deviceResultCount");


        let activeFilter = "All";


        function filterDevices() {

            const search =
                searchInput.value
                    .trim()
                    .toLowerCase();


            let visibleCount = 0;


            rows.forEach(function (row) {

                const status =
                    row.dataset.status;

                const searchableText =
                    row.dataset.search.toLowerCase();


                const matchesFilter =
                    activeFilter === "All" ||
                    status === activeFilter;


                const matchesSearch =
                    search === "" ||
                    searchableText.includes(search);


                const shouldShow =
                    matchesFilter &&
                    matchesSearch;


                row.style.display =
                    shouldShow ? "" : "none";


                if (shouldShow) {
                    visibleCount++;
                }

            });


            <!-- Update count -->

            resultCount.textContent =
                `Showing ${visibleCount} meter${visibleCount === 1 ? "" : "s"}`;


            <!-- Empty state -->

            emptyState.style.display =
                visibleCount === 0 ? "block" : "none";

        }


        <!-- =================================================
             FILTER BUTTONS
             ================================================= -->

        filterButtons.forEach(function (button) {

            button.addEventListener("click", function () {

                activeFilter =
                    button.dataset.filter;


                <!-- Update active button -->

                filterButtons.forEach(function (btn) {

                    btn.classList.remove("active");

                });


                button.classList.add("active");


                filterDevices();

            });

        });


        <!-- =================================================
             SEARCH
             ================================================= -->

        searchInput.addEventListener(
            "input",
            filterDevices
        );


        <!-- Initial state -->

        filterDevices();

    });

</script>