@{
    ViewData["Title"] = "Error";
}
<div class="card" style="max-width:480px; margin:40px auto; text-align:center;">
    <i class="bi bi-exclamation-triangle" style="font-size:28px; color:var(--red);"></i>
    <h1 style="font-size:18px; margin:12px 0 4px;">Something went wrong</h1>
    <p style="color:var(--muted-foreground); font-size:14px;">An unexpected error occurred.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary" style="margin-top:12px; display:inline-block;">Back to Dashboard</a>
</div>