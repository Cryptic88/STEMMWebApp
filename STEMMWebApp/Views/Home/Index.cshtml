<!-- =========================================================
     DEPARTMENTS
     ========================================================= -->

<div class="card"
     style="margin-bottom:24px;">

    <div class="section-head">

        <span class="section-title">
            Departments
        </span>

        <a asp-controller="Reports"
           asp-action="Index"
           class="section-action">
            View All
        </a>

    </div>


    <table class="data-table">

        <thead>

            <tr>

                <th>Department</th>

                <th>Usage (kWh)</th>

                <th>Budget (kWh)</th>

                <th>Utilization</th>

                <th>Trend</th>

                <th>Status</th>

            </tr>

        </thead>


        <tbody>

            @foreach (var d in departments)
            {
                var pct = Math.Min(
                    100,
                    (d.Usage / d.Budget) * 100
                );

                <tr>

                    <td style="font-weight:500;">
                        @d.Name
                    </td>


                    <td class="mono"
                        style="color:var(--primary);">

                        @d.Usage.ToString("0.0")

                    </td>


                    <td class="mono"
                        style="color:var(--muted-foreground);">

                        @d.Budget.ToString("0")

                    </td>


                    <td>

                        <div style="display:flex;
                                    align-items:center;
                                    gap:8px;">

                            <div class="progress-track"
                                 style="flex:1;
                                        max-width:96px;">

                                <div class="progress-fill"
                                     style="width:@(pct.ToString("0"))%;">
                                </div>

                            </div>


                            <span class="mono"
                                  style="font-size:11px;
                                         color:var(--muted-foreground);">

                                @pct.ToString("0")%

                            </span>

                        </div>

                    </td>


                    <td>

                        <span class="mono"
                              style="font-size:12px;
                                     font-weight:500;
                                     color:@(d.Trend >= 0
                                         ? "#f87171"
                                         : "#34d399");">

                            <i class="bi bi-arrow-@(d.Trend >= 0 ? "up" : "down")"></i>

                            @Math.Abs(d.Trend)%

                        </span>

                    </td>


                    <td>

                        <span class="badge @StatusBadgeClass(d.Status)">
                            @d.Status
                        </span>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


<!-- =========================================================
     RECENT ALERTS
     ========================================================= -->

<div class="card">

    <div class="section-head">

        <span class="section-title">
            Recent Alerts
        </span>

        <a asp-controller="Alerts"
           asp-action="Index"
           class="section-action">
            View All
        </a>

    </div>


    @foreach (var a in alerts.Take(4))
    {

    <a asp-controller="Alerts"
       asp-action="Detail"
       asp-route-id="@a.Id"
       class="list-row dashboard-alert-link"
           style="
                padding-left:0;
                padding-right:0;
                text-decoration:none;
                color:inherit;
                cursor:pointer;
           ">

            <!-- Alert icon -->

            <span style="
                color:@(
                    a.Type == "Critical"
                        ? "var(--red)"
                        : a.Type == "Warning"
                            ? "var(--amber)"
                            : "var(--cyan)"
                );
                flex-shrink:0;
            ">

                <i class="bi bi-@(
                    a.Type == "Critical"
                        ? "exclamation-triangle"
                        : a.Type == "Warning"
                            ? "exclamation-circle"
                            : "activity"
                )"></i>

            </span>


            <!-- Alert content -->

            <div style="
                flex:1;
                min-width:0;
            ">

                <div style="
                    display:flex;
                    align-items:center;
                    gap:8px;
                    margin-bottom:2px;
                ">

                    <span class="badge @StatusBadgeClass(a.Type)">
                        @a.Type
                    </span>

                    <span style="
                        font-size:12px;
                        color:var(--muted-foreground);
                    ">

                        @a.Dept

                    </span>

                </div>


                <p style="
                    font-size:14px;
                    margin:0;
                    white-space:nowrap;
                    overflow:hidden;
                    text-overflow:ellipsis;
                ">

                    @a.Msg

                </p>

            </div>


            <!-- Time + resolved -->

            <div style="
                display:flex;
                flex-direction:column;
                align-items:flex-end;
                gap:4px;
                flex-shrink:0;
            ">

                <span class="mono"
                      style="
                        font-size:11px;
                        color:var(--muted-foreground);
                      ">

                    @a.Time

                </span>


                @if (a.Resolved)
                {
                    <i class="bi bi-check-circle"
                       style="
                            color:var(--primary);
                            font-size:13px;
                       ">
                    </i>
                }

            </div>


            <!-- Arrow -->

            <i class="bi bi-chevron-right"
               style="
                    margin-left:8px;
                    color:var(--muted-foreground);
                    font-size:12px;
               ">
            </i>

        </a>

    }

</div>