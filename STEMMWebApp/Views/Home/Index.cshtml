@using STEMMWebApp.Models

@{
    ViewData["Title"] = "Dashboard";

    var departments = (List<Department>)ViewBag.Departments;
    var alerts = (List<AlertItem>)ViewBag.Alerts;

    var totalUsage = departments.Sum(d => d.Usage);

    var criticalCount = alerts.Count(a =>
        !a.Resolved && a.Type == "Critical");

    var activeAlerts = alerts.Count(a => !a.Resolved);

    var meters = SampleData.Meters;

    var onlineCount = meters.Count(m => m.Status == "Online");
    var offlineCount = meters.Count(m => m.Status == "Offline");

    string StatusBadgeClass(string s) => s switch
    {
        "Critical" => "badge-critical",
        "Warning" => "badge-warning",
        "Online" or "Normal" => "badge-online",
        "Offline" => "badge-offline",
        _ => "badge-info",
    };
}

<!-- =========================================================
     SUMMARY CARDS
     ========================================================= -->

<div class="grid grid-4" style="margin-bottom:24px;">

    <div class="card stat-card">

        <span class="stat-label">
            Total Usage Today
        </span>

        <span class="stat-value">
            @totalUsage.ToString("0") kWh
        </span>

        <span class="stat-sub">
            Across all departments
        </span>

        <span class="stat-trend up">
            <i class="bi bi-arrow-up"></i>
            3.2% vs last week
        </span>

    </div>


    <div class="card stat-card">

        <span class="stat-label">
            Active Alerts
        </span>

        <span class="stat-value">
            @activeAlerts
        </span>

        <span class="stat-sub">
            @criticalCount critical
        </span>

    </div>


    <div class="card stat-card">

        <span class="stat-label">
            Devices Online
        </span>

        <span class="stat-value">
            @onlineCount/@meters.Count
        </span>

        <span class="stat-sub">
            @offlineCount offline
        </span>

    </div>


    <div class="card stat-card">

        <span class="stat-label">
            Est. Daily Cost
        </span>

        <span class="stat-value">
            R2,387
        </span>

        <span class="stat-sub">
            Budget: R2,800
        </span>

        <span class="stat-trend down">
            <i class="bi bi-arrow-down"></i>
            1.4% vs last week
        </span>

    </div>

</div>


<!-- =========================================================
     QUICK ACTIONS
     ========================================================= -->

<div style="margin-bottom:24px;">

    <div class="section-head">
        <span class="section-title">
            Quick Actions
        </span>
    </div>

    <div style="display:flex; flex-wrap:wrap; gap:12px;">

        <a asp-controller="Alerts"
           asp-action="Index"
           class="btn"
           style="display:inline-flex; align-items:center; gap:8px; background:var(--secondary);">

            <i class="bi bi-exclamation-triangle"
               style="color:var(--primary);"></i>

            Active Alerts

        </a>


        <a asp-controller="Devices"
           asp-action="Index"
           class="btn"
           style="display:inline-flex; align-items:center; gap:8px; background:var(--secondary);">

            <i class="bi bi-cpu"
               style="color:var(--primary);"></i>

            Device Status

        </a>


        <a asp-controller="Reports"
           asp-action="Index"
           class="btn"
           style="display:inline-flex; align-items:center; gap:8px; background:var(--secondary);">

            <i class="bi bi-bar-chart"
               style="color:var(--primary);"></i>

            Usage Reports

        </a>

    </div>

</div>


