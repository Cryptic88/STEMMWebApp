@using STEMMWebApp.Models

@{
    var currentController = (string)ViewContext.RouteData.Values["controller"]!;
    int unresolvedAlerts = SampleData.Alerts.Count(a => !a.Resolved);
    bool IsActive(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — S.T.E.M.M.</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo"><i class="bi bi-lightning-charge-fill"></i></div>
                <span class="sidebar-label sidebar-title">S.T.E.M.M.</span>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="nav-item @(IsActive("Home") ? "active" : "")">
                    <i class="bi bi-house"></i>
                    <span class="sidebar-label">Dashboard</span>
                </a>
                <a asp-controller="Devices" asp-action="Index" class="nav-item @(IsActive("Devices") ? "active" : "")">
                    <i class="bi bi-cpu"></i>
                    <span class="sidebar-label">Devices</span>
                </a>
                <a asp-controller="Alerts" asp-action="Index" class="nav-item @(IsActive("Alerts") ? "active" : "")">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span class="sidebar-label">Alerts</span>
                    @if (unresolvedAlerts > 0)
                    {
                        <span class="nav-badge sidebar-label">@unresolvedAlerts</span>
                    }
                </a>
                <a asp-controller="Reports" asp-action="Index" class="nav-item @(IsActive("Reports") ? "active" : "")">
                    <i class="bi bi-bar-chart"></i>
                    <span class="sidebar-label">Reports</span>
                </a>
                <a asp-controller="Settings" asp-action="Index" class="nav-item @(IsActive("Settings") ? "active" : "")">
                    <i class="bi bi-gear"></i>
                    <span class="sidebar-label">Settings</span>
                </a>
            </nav>

            <div class="sidebar-user">
                <div class="label">Signed in as</div>
                <div class="value">Operations Manager</div>
            </div>
        </aside>

        <div class="main-col">
            <header class="topbar">
                <button class="icon-btn" id="sidebarToggle" title="Toggle sidebar"><i class="bi bi-list" style="font-size:18px;"></i></button>
                <div class="search-box d-none d-lg-block">
                    <i class="bi bi-search" style="font-size:14px;"></i>
                    <input type="text" placeholder="Search…" />
                </div>
                <div style="flex:1"></div>
                <a class="icon-btn" asp-controller="Notifications" asp-action="Index" title="Notifications">
                    <i class="bi bi-bell" style="font-size:18px;"></i>
                    <span class="notif-dot">3</span>
                </a>
                <a class="avatar" asp-controller="Settings" asp-action="EditProfile" title="Profile">OP</a>
            </header>

            <main class="page">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>