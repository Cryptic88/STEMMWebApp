@{
    ViewData["Title"] = "Settings";
}

<div class="card" style="max-width:640px; margin-bottom:20px;">
    <div class="section-head"><span class="section-title">Account</span></div>
    <div class="list-row" style="padding-left:0; padding-right:0; cursor:pointer;" onclick="location.href='@Url.Action("EditProfile", "Settings")'">
        <div class="avatar" style="cursor:pointer;">OP</div>
        <div style="flex:1;">
            <div style="font-weight:500;">Operations Manager</div>
            <div style="font-size:12px; color:var(--muted-foreground);">Edit profile details</div>
        </div>
        <i class="bi bi-chevron-right" style="color:var(--muted-foreground);"></i>
    </div>
</div>

<div class="card" style="max-width:640px; margin-bottom:20px;">
    <div class="section-head"><span class="section-title">Preferences</span></div>
    <div style="display:flex; flex-direction:column; gap:16px;">
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <div>
                <div style="font-weight:500; font-size:14px;">Push Notifications</div>
                <div style="font-size:12px; color:var(--muted-foreground);">Alerts and reports</div>
            </div>
            <div class="toggle on"><span class="knob"></span></div>
        </div>
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <div>
                <div style="font-weight:500; font-size:14px;">Email Digest</div>
                <div style="font-size:12px; color:var(--muted-foreground);">Weekly summary email</div>
            </div>
            <div class="toggle"><span class="knob"></span></div>
        </div>
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <div>
                <div style="font-weight:500; font-size:14px;">Dark Mode</div>
                <div style="font-size:12px; color:var(--muted-foreground);">Always on for this theme</div>
            </div>
            <div class="toggle on"><span class="knob"></span></div>
        </div>
    </div>
</div>

<div class="card" style="max-width:640px;">
    <div class="section-head"><span class="section-title">Session</span></div>
    <a asp-controller="Account" asp-action="Logout" class="btn" style="display:inline-flex; align-items:center; gap:8px; color:var(--red);">
        <i class="bi bi-box-arrow-right"></i> Log Out
    </a>
</div>