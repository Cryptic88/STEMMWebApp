@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}
<div class="login-page">
    <div class="login-card">
        <div class="login-logo"><i class="bi bi-lightning-charge-fill" style="font-size:22px;"></i></div>
        <div class="login-title">S.T.E.M.M.</div>
        <div class="login-sub">Smart Energy Monitoring &amp; Management</div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="field">
                <label>Email</label>
                <input type="email" name="email" placeholder="you@company.com" />
            </div>
            <div class="field">
                <label>Password</label>
                <input type="password" name="password" placeholder="••••••••" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Sign In</button>
        </form>

        <div style="text-align:center; margin-top:16px; font-size:12px; color:var(--muted-foreground);">
            UI preview only — sign-in isn't validated yet.
        </div>
    </div>
</div>
