@using STEMMWebApp.Models

@model List<AlertItem>
@{
    ViewData["Title"] = "Alerts";
    string BadgeClass(string t) => t switch { "Critical" => "badge-critical", "Warning" => "badge-warning", _ => "badge-info" };
    string IconFor(string t) => t switch { "Critical" => "exclamation-triangle", "Warning" => "exclamation-circle", _ => "activity" };
}

<div class="grid grid-3" style="margin-bottom:24px;">
    <div class="card stat-card">
        <span class="stat-label">Open Alerts</span>
        <span class="stat-value">@Model.Count(a => !a.Resolved)</span>
        <span class="stat-sub">Needs attention</span>
    </div>
    <div class="card stat-card">
        <span class="stat-label">Critical</span>
        <span class="stat-value">@Model.Count(a => a.Type == "Critical" && !a.Resolved)</span>
        <span class="stat-sub">Unresolved</span>
    </div>
    <div class="card stat-card">
        <span class="stat-label">Resolved Today</span>
        <span class="stat-value">@Model.Count(a => a.Resolved)</span>
        <span class="stat-sub">Closed out</span>
    </div>
</div>

<div class="card">
    <div class="section-head"><span class="section-title">All Alerts</span></div>
    @foreach (var a in Model)
    {
        <div class="list-row" style="padding-left:0; padding-right:0; cursor:pointer;" onclick="location.href='@Url.Action("Detail", "Alerts", new { id = a.Id })'">
            <span style="color:@(a.Type == "Critical" ? "var(--red)" : a.Type == "Warning" ? "var(--amber)" : "var(--cyan)");">
                <i class="bi bi-@(IconFor(a.Type))"></i>
            </span>
            <div style="flex:1; min-width:0;">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px;">
                    <span class="badge @BadgeClass(a.Type)">@a.Type</span>
                    <span style="font-size:12px; color:var(--muted-foreground);">@a.Dept &middot; @a.Meter</span>
                    @if (a.Assigned != null)
                    {
                        <span style="font-size:12px; color:var(--muted-foreground);">&middot; @a.Assigned</span>
                    }
                </div>
                <p style="font-size:14px; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@a.Msg</p>
            </div>
            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px; flex-shrink:0;">
                <span class="mono" style="font-size:11px; color:var(--muted-foreground);">@a.Time &middot; @a.Date</span>
                @if (a.Resolved)
                {
                    <span class="badge badge-online" style="font-size:10px;">Resolved</span>
                }
            </div>
        </div>
    }
</div>
