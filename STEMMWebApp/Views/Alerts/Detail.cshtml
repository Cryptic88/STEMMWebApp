@using STEMMWebApp.Models

@model AlertItem

@{
    ViewData["Title"] = $"Alert {Model.Id}";

    string AlertIcon(string type) => type switch
    {
        "Critical" => "exclamation-triangle-fill",
        "Warning" => "exclamation-circle-fill",
        _ => "info-circle-fill"
    };

    string AlertColor(string type) => type switch
    {
        "Critical" => "var(--red)",
        "Warning" => "var(--amber)",
        _ => "var(--cyan)"
    };
}


<a asp-controller="Alerts"
   asp-action="Index"
   class="back-btn">

    <i class="bi bi-chevron-left"></i>
    Alerts

</a>


<!-- =========================================================
     ALERT HEADER
     ========================================================= -->

<div class="alert-detail-header">

    <div class="alert-detail-icon"
         style="color:@AlertColor(Model.Type);">

        <i class="bi bi-@AlertIcon(Model.Type)"></i>

    </div>

    <div class="alert-detail-heading">

        <div class="alert-detail-type"
             style="color:@AlertColor(Model.Type);">

            @Model.Type ALERT

        </div>

        <h1>
            @Model.Msg
        </h1>

        <div class="alert-detail-device">

            <i class="bi bi-cpu"></i>

            @Model.Meter

            <span>·</span>

            @Model.Dept

        </div>

    </div>

</div>


<!-- =========================================================
     STATUS
     ========================================================= -->

<div class="alert-detail-status">

    @if (Model.Resolved)
    {
        <div class="alert-status-resolved">

            <i class="bi bi-check-circle-fill"></i>

            Alert resolved

        </div>
    }
    else
    {
        <div class="alert-status-open">

            <span class="live-dot"></span>

            Alert requires attention

        </div>
    }

</div>


<!-- =========================================================
     ALERT INFORMATION
     ========================================================= -->

<div class="alert-detail-grid">

    <div class="alert-detail-card">

        <span class="section-eyebrow">
            DEVICE
        </span>

        <strong>
            @Model.Meter
        </strong>

        <small>
            @Model.Dept
        </small>

    </div>


    <div class="alert-detail-card">

        <span class="section-eyebrow">
            REPORTED
        </span>

        <strong class="mono">
            @Model.Time
        </strong>

        <small>
            @Model.Date
        </small>

    </div>


    <div class="alert-detail-card">

        <span class="section-eyebrow">
            ASSIGNED TO
        </span>

        <strong>
            @(Model.Assigned ?? "Unassigned")
        </strong>

        <small>
            Responsible technician
        </small>

    </div>

</div>


<!-- =========================================================
     DETAILS
     ========================================================= -->

<div class="alert-detail-description">

    <div class="section-eyebrow">
        DESCRIPTION
    </div>

    <p>
        @Model.Detail
    </p>

</div>


<!-- =========================================================
     TIMELINE
     ========================================================= -->

<div class="alert-timeline-card">

    <div class="device-section-header">

        <div>

            <span class="section-eyebrow">
                ACTIVITY
            </span>

            <h2>
                Timeline
            </h2>

        </div>

        <i class="bi bi-clock-history"></i>

    </div>


    <div class="alert-timeline">

        @foreach (var t in Model.Timeline)
        {
            <div class="alert-timeline-item">

                <div class="alert-timeline-marker">

                    <span></span>

                </div>

                <div class="alert-timeline-content">

                    <div>

                        <strong>
                            @t.Event
                        </strong>

                        <span class="mono">
                            @t.Time
                        </span>

                    </div>

                    <small>
                        @t.Actor
                    </small>

                </div>

            </div>
        }

    </div>

</div>


<!-- =========================================================
     ACTION
     ========================================================= -->

@if (!Model.Resolved)
{
    <div class="alert-detail-action">

        <button class="btn btn-primary"
                onclick="resolveAlert()">

            <i class="bi bi-check-lg"></i>

            Mark as resolved

        </button>

    </div>
}
else
{
    <div class="alert-detail-action">

        <div class="resolved-message">

            <i class="bi bi-check-circle-fill"></i>

            This alert has been resolved.

        </div>

    </div>
}


<script>

    function resolveAlert() {

        // UI only for now
        const button =
            document.querySelector(".alert-detail-action button");

        button.innerHTML =
            '<i class="bi bi-check-circle-fill"></i> Resolved';

        button.disabled = true;

        button.style.opacity = "0.65";

    }

</script>